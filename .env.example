# Public Supabase configuration. Safe to expose to the browser with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application origin used for secure authentication callbacks.
# Keep localhost for local development; use the HTTPS origin in production.
SITE_URL=http://localhost:3000

# Server-only Supabase access. Never expose this value to client code.
SUPABASE_SERVICE_ROLE_KEY=

# PayPal Checkout server credentials. Use sandbox locally and live only after business onboarding.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Server-only salt used to hash inquiry rate-limit identifiers. Use at least 32 random characters.
INQUIRY_FINGERPRINT_SALT=

# Resend server-only API key and verified sender mailbox used for paid-order delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudflare Turnstile CAPTCHA configuration.
# Public site key for widget rendering (0x4AAAAAAEAePr_u0WZWa_bF).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secret used for canonical Cloudflare siteverify validation.
# Never expose this value to client code.
TURNSTILE_SECRET=
