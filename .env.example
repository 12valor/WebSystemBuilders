# Public Supabase configuration. Safe to expose to the browser with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application origin used for secure authentication callbacks.
# Keep localhost for local development; use the HTTPS origin in production.
SITE_URL=http://localhost:3000

# Server-only Supabase access. Never expose this value to client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only salt used to hash inquiry rate-limit identifiers. Use at least 32 random characters.
INQUIRY_FINGERPRINT_SALT=

# Lemon Squeezy server-only API key, store ID, and signing secret for webhooks.
# Register /api/webhooks/lemonsqueezy for order_created / order_paid after the site has a public HTTPS origin.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Resend server-only API key and verified sender mailbox used for paid-order delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
